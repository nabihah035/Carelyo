<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Child Avatar Circle -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvChildAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E8EAF6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_child"
                android:tint="#5C6BC0" />

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvChildName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Child Name"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/cvChildAvatar"
            app:layout_constraintTop_toTopOf="@+id/cvChildAvatar"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvChildAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 years old"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintStart_toStartOf="@+id/tvChildName"
            app:layout_constraintTop_toBottomOf="@+id/tvChildName" />

        <TextView
            android:id="@+id/tvChildDob"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Born: Jan 15, 2020"
            android:textSize="13sp"
            android:textColor="@android:color/darker_gray"
            app:layout_constraintStart_toEndOf="@+id/tvChildAge"
            app:layout_constraintTop_toBottomOf="@+id/tvChildName"
            android:layout_marginStart="16dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>