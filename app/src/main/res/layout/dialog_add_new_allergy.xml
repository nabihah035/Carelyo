<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Allergy"
        android:textColor="#0F172A"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle_gray_btn"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#64748B" />

    <TextView
        android:id="@+id/tvChooseChildLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Choose Child *"
        android:textColor="#475569"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/menuChooseChild"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:hintEnabled="false"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvChooseChildLabel">

        <AutoCompleteTextView
            android:id="@+id/actvChooseChild"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_input_field"
            android:hint="Select a child"
            android:inputType="none"
            android:paddingHorizontal="16dp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="16sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <EditText
        android:id="@+id/etAllergenName"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_input_field"
        android:hint="Allergen name *"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuChooseChild" />

    <TextView
        android:id="@+id/tvTypeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Type"
        android:textColor="#475569"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etAllergenName" />

    <LinearLayout
        android:id="@+id/llTypeButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTypeLabel">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeFood"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#F1F5F9"
            android:text="Food"
            android:textAllCaps="false"
            android:textColor="#334155"
            app:cornerRadius="12dp"
            app:strokeColor="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeMedication"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#F1F5F9"
            android:text="Medication"
            android:textAllCaps="false"
            android:textColor="#334155"
            app:cornerRadius="12dp"
            app:strokeColor="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeEnvironmental"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="#F1F5F9"
            android:text="Environmental"
            android:textAllCaps="false"
            android:textColor="#334155"
            app:cornerRadius="12dp"
            app:strokeColor="@android:color/transparent" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSeverityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Severity"
        android:textColor="#475569"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llTypeButtons" />

    <LinearLayout
        android:id="@+id/llSeverityButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSeverityLabel">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeverityMild"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#F1F5F9"
            android:text="Mild"
            android:textAllCaps="false"
            android:textColor="#334155"
            app:cornerRadius="12dp"
            app:strokeColor="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeverityModerate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#F1F5F9"
            android:text="Moderate"
            android:textAllCaps="false"
            android:textColor="#334155"
            app:cornerRadius="12dp"
            app:strokeColor="@android:color/transparent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeveritySevere"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="#F1F5F9"
            android:text="Severe"
            android:textAllCaps="false"
            android:textColor="#334155"
            app:cornerRadius="12dp"
            app:strokeColor="@android:color/transparent" />
    </LinearLayout>

    <EditText
        android:id="@+id/etReactionDescription"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_input_field"
        android:hint="Reaction description"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llSeverityButtons" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddAllergy"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#F87171"
        android:text="✓ Add Allergy"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etReactionDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>