<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Record"
        android:textColor="#0F172A"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle_gray_btn"
        android:padding="8dp"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#64748B" />

    <TextView
        android:id="@+id/tvChooseChildLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Choose Child *"
        android:textColor="#475569"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/menuChooseChild"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:hintEnabled="false"
        app:boxStrokeWidth="0dp"
        app:boxStrokeWidthFocused="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvChooseChildLabel">

        <AutoCompleteTextView
            android:id="@+id/actvChooseChild"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_input_field"
            android:hint="Select a child"
            android:inputType="none"
            android:paddingHorizontal="16dp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:id="@+id/svRecordTypes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menuChooseChild">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConsultation"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:backgroundTint="#F1F5F9"
                android:text="Consultation"
                android:textAllCaps="false"
                android:textColor="#334155"
                app:cornerRadius="14dp"
                app:strokeColor="@android:color/transparent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCheckup"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#F1F5F9"
                android:text="Checkup"
                android:textAllCaps="false"
                android:textColor="#334155"
                app:cornerRadius="14dp"
                app:strokeColor="@android:color/transparent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVaccination"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#F1F5F9"
                android:text="Vaccination"
                android:textAllCaps="false"
                android:textColor="#334155"
                app:cornerRadius="14dp"
                app:strokeColor="@android:color/transparent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmergency"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#F1F5F9"
                android:text="Emergency"
                android:textAllCaps="false"
                android:textColor="#334155"
                app:cornerRadius="14dp"
                app:strokeColor="@android:color/transparent" />
        </LinearLayout>
    </HorizontalScrollView>

    <EditText
        android:id="@+id/etDoctorName"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_input_field"
        android:hint="Doctor name *"
        android:importantForAutofill="no"
        android:inputType="textPersonName"
        android:paddingHorizontal="16dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/svRecordTypes" />

    <EditText
        android:id="@+id/etClinicHospital"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="Clinic / Hospital"
        android:importantForAutofill="no"
        android:inputType="textPostalAddress"
        android:paddingHorizontal="16dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etDoctorName" />

    <EditText
        android:id="@+id/etDiagnosis"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_field"
        android:hint="Diagnosis *"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etClinicHospital" />

    <EditText
        android:id="@+id/etNotesPrescriptions"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_input_field"
        android:gravity="top|start"
        android:hint="Notes / Prescriptions"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        android:padding="16dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etDiagnosis" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveRecord"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#7DD3FC"
        android:text="✓ Save Record"
        android:textAllCaps="false"
        android:textColor="#0F172A"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etNotesPrescriptions" />

</androidx.constraintlayout.widget.ConstraintLayout>