<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:fillViewport="true"
    android:paddingTop="25dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Progress Bar ───────────────────────────────────────────── -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- ── Child Selector ─────────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/childSelectorContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <!-- Avatar circle -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_blue" />

                    <ImageView
                        android:id="@+id/ivChildAvatar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_child_avatar"
                        app:tint="#FFFFFF"
                        android:contentDescription="Child Avatar" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Viewing profile for"
                        android:textSize="11sp"
                        android:textColor="#888888"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvChildSelectorText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Child"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A2E"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivDropdownIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_dropdown"
                    android:visibility="gone"
                    app:tint="#888888"
                    android:contentDescription="Select child" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ── Child Details Card ──────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardChildDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Child name + age (centered) -->
                <TextView
                    android:id="@+id/tvChildName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aiden Razif"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:gravity="center"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvChildAge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="2 years old"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:gravity="center" />

                <!-- Thin separator -->
                <View
                    android:layout_width="48dp"
                    android:layout_height="2dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#4A90D9" />

                <!-- Metrics row: Weight | Height | Blood Type -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Weight -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp"
                        android:background="@drawable/bg_metric_tile">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚖"
                            android:textSize="18sp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvWeightValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="-- kg"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Weight"
                            android:textSize="11sp"
                            android:textColor="#888888"
                            android:gravity="center" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="48dp"
                        android:background="#E8ECF0"
                        android:layout_marginHorizontal="4dp" />

                    <!-- Height -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp"
                        android:background="@drawable/bg_metric_tile">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📏"
                            android:textSize="18sp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvHeightValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="-- cm"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Height"
                            android:textSize="11sp"
                            android:textColor="#888888"
                            android:gravity="center" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="48dp"
                        android:background="#E8ECF0"
                        android:layout_marginHorizontal="4dp" />

                    <!-- Blood Type -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp"
                        android:background="@drawable/bg_metric_tile">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🩸"
                            android:textSize="18sp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/tvBloodTypeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="A+"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Blood Type"
                            android:textSize="11sp"
                            android:textColor="#888888"
                            android:gravity="center" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ── Quick Actions Header ────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="Quick Actions"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:letterSpacing="0.02" />

        <!-- ── Quick Actions Card ──────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardQuickActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <!-- Health Records button -->
                <LinearLayout
                    android:id="@+id/btnHealthRecords"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_action_blue"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_health_record"
                        app:tint="#1565C0"
                        android:contentDescription="Health Records" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Health Records"
                        android:textSize="13sp"
                        android:textColor="#1565C0"
                        android:textStyle="bold"
                        android:gravity="center" />

                </LinearLayout>

                <!-- Doctor Summary button -->
                <LinearLayout
                    android:id="@+id/btnDoctorSummary"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:background="@drawable/bg_action_purple"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_doctor_summary"
                        app:tint="#6A1B9A"
                        android:contentDescription="Doctor Summary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Doctor Summary"
                        android:textSize="13sp"
                        android:textColor="#6A1B9A"
                        android:textStyle="bold"
                        android:gravity="center" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ── Upcoming Header ─────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="Upcoming"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:letterSpacing="0.02" />

        <!-- ── Upcoming Card ───────────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardUpcoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Vaccination Due row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="14dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <View
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_green" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_vaccines"
                            app:tint="#FFFFFF"
                            android:contentDescription="Vaccination" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Vaccination Due"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A2E" />

                            <TextView
                                android:id="@+id/tvVaccinationCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+1 more"
                                android:textSize="11sp"
                                android:textColor="#FF8F00"
                                android:background="@drawable/bg_badge_orange"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:visibility="gone" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvVaccinationDue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="MMR Dose 2 — Due: Jun 20, 2026"
                            android:textSize="13sp"
                            android:textColor="#555555" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEF0F3" />

                <!-- Medication Reminder row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <View
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_red" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_remind"
                            app:tint="#FFFFFF"
                            android:contentDescription="Medication" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Medication Reminder"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A2E" />

                            <TextView
                                android:id="@+id/tvMedicationCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+1 more"
                                android:textSize="11sp"
                                android:textColor="#FF8F00"
                                android:background="@drawable/bg_badge_orange"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:visibility="gone" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvMedicationReminder"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Paracetamol — 5ml at 8:00 AM"
                            android:textSize="13sp"
                            android:textColor="#555555" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEF0F3" />

                <!-- Clinic Appointment row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <View
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_blue" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_reminders"
                            app:tint="#FFFFFF"
                            android:contentDescription="Appointment" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Clinic Appointment"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A2E" />

                            <TextView
                                android:id="@+id/tvAppointmentCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+1 more"
                                android:textSize="11sp"
                                android:textColor="#FF8F00"
                                android:background="@drawable/bg_badge_orange"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:visibility="gone" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvClinicAppointment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="KPJ Damansara Clinic — Jun 15, 2026 at 10:30"
                            android:textSize="13sp"
                            android:textColor="#555555" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>