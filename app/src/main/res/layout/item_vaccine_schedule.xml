<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Left Circular Status Icon Background -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvStatusIconBackground"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="#EAF7EC"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check_circle"
                app:tint="#2E7D32" />
        </androidx.cardview.widget.CardView>

        <!-- Vaccine Details Group -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvVaccineName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#262626"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="BCG" />

                <!-- Child Name Badge -->
                <TextView
                    android:id="@+id/tvChildNameBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_input_field"
                    android:backgroundTint="#E8F5E9"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Aisyah"
                    android:textColor="#2E7D32"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVaccineAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8C8C8C"
                android:textSize="12sp"
                tools:text="At birth" />

            <TextView
                android:id="@+id/tvVaccineStatusDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Given: 15 Jan 2024" />
        </LinearLayout>

        <!-- Trailing Chevron Icon -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="View details"
            android:src="@drawable/ic_chevron_right"
            app:tint="#CCCCCC" />

    </LinearLayout>
</androidx.cardview.widget.CardView>