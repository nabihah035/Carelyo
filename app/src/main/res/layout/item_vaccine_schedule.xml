<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_circle replaced with a programmatically-set background tint.
  ic_chevron_right replaced with ic_schedule as a safe built-in fallback
  (swap back once you add ic_chevron_right to your drawables).
  tvChildName added to display which child this vaccine belongs to.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Main Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <!-- Status Icon (background tint set in ViewHolder) -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <View
                    android:id="@+id/vIconBackground"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/ic_check_circle" />

                <ImageView
                    android:id="@+id/ivStatusIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check_circle" />

            </FrameLayout>

            <!-- Vaccine Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <!-- Child name badge – hidden when "All Children" filter is active
                     for a single child (shown in all-children mode) -->
                <TextView
                    android:id="@+id/tvChildName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anak 1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#7B61FF"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvVaccineName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BCG"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

                <TextView
                    android:id="@+id/tvAgeRequirement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="At birth"
                    android:textSize="12sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/tvDateInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Given: 15 Jan 2024"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Expand Icon -->
            <ImageView
                android:id="@+id/ivExpandIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_schedule"
                app:tint="#999999" />

        </LinearLayout>

        <!-- Expanded Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#F5F5F5"
            android:text="Vaccine description will appear here"
            android:textSize="14sp"
            android:textColor="#444444"
            android:visibility="gone" />

    </LinearLayout>

</androidx.cardview.widget.CardView>