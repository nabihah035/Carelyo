<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Left Circular Status Icon Background -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvStatusIconBackground"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="#EAF8EE"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivStatusIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="#10B981" />
        </androidx.cardview.widget.CardView>

        <!-- Vaccine Details Group -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVaccineName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="BCG" />

            <TextView
                android:id="@+id/tvVaccineAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#64748B"
                android:textSize="13sp"
                tools:text="At birth" />

            <TextView
                android:id="@+id/tvVaccineStatusDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#10B981"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Given: 15 Jan 2024" />

            <!-- Hidden compatibility view -->
            <TextView
                android:id="@+id/tvChildNameBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Trailing Chevron Icon -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="View details"
            android:src="@drawable/ic_chevron_right"
            app:tint="#94A3B8" />

    </LinearLayout>
</androidx.cardview.widget.CardView>